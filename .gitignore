# ROMs and ROM images: never commit
*.zip
*.rom
*.bin
*.nv
*.nvm

# Quartus
output_files/
db/
incremental_db/
*.rpt
*.summary
*.done
*.pin
*.jdi
*.sof
*.srf
build_id.v
compile.log
