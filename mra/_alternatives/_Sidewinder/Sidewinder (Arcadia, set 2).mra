<misterromdescription>
    <name>Sidewinder (Arcadia, set 2)</name>
    <setname>ar_sdwr2</setname>
    <mameversion>0289</mameversion>
    <year>1988</year>
    <manufacturer>Arcadia Systems</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rotation>horizontal</rotation>
    <rbf>arcadiasystems</rbf>
    <platform>Arcadia Systems</platform>
    <!-- The image (rtl/arcadia_loader.v): a 16-byte header (the ROM board's low-byte permutation, MAME's generic_decode
         order bit 7..0; flags, bit 0 Aaargh's map), Kickstart 1.3 (512 KB), the BIOS (512 KB, OnePlay 3.00 as MAME's
         default), the ROM board (1.5 MB). The ROMs stay as dumped: the core unscrambles them.
         Expects the MAME 0.289 merged romset or the split sets. Written by tools/make_mra.py. -->
    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,R"/>
    <rom index="0" zip="ar_sdwr2.zip|ar_sdwr.zip|ar_bios.zip" md5="66a99a3570c237153de6dc11897bbe27">
        <!-- header -->
        <part>06 03 04 05 02 01 00 07 00 00 00 00 00 00 00 00</part>
        <!-- kickstart: Kickstart 1.3, twice -->
        <part name="315093-01.u2" crc="a6ce1636"/>
        <part name="315093-01.u2" crc="a6ce1636"/>
        <!-- user2: the BIOS, OnePlay 3.00 -->
        <interleave output="16">
            <part name="scpa_01-hi_v3.0.u12" crc="2d8e1a06" map="01"/>
            <part name="scpa_01-lo_v3.0.u16" crc="e4f38fab" map="10"/>
        </interleave>
        <part repeat="0x60000">00</part>
        <!-- user3: the ROM board -->
        <interleave output="16">
            <part name="arcadia1.u10" crc="30949f1f" map="01"/>
            <part name="arcadia1.u6" crc="c760d1c4" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="arcadia1.u11" crc="d67ba564" map="01"/>
            <part name="arcadia1.u7" crc="97f58a6d" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="arcadia1.u12" crc="b31ad2b2" map="01"/>
            <part name="arcadia1.u8" crc="af929620" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="arcadia1.u13" crc="360b17a6" map="01"/>
            <part name="arcadia1.u9" crc="d724e563" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="arcadia1.u19" crc="c25ac91d" map="01"/>
            <part name="arcadia1.u15" crc="ecd1fbd3" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="arcadia1.u20" crc="5791440b" map="01"/>
            <part name="arcadia1.u16" crc="e63e1679" map="10"/>
        </interleave>
        <part repeat="0xC0000">00</part>
    </rom>
    <nvram index="4" size="16384"/>
</misterromdescription>
