<misterromdescription>
    <name>Spot (Arcadia, V 2.0)</name>
    <setname>ar_spot</setname>
    <mameversion>0289</mameversion>
    <year>1990</year>
    <manufacturer>Arcadia Systems</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rotation>horizontal</rotation>
    <rbf>arcadiasystems</rbf>
    <platform>Arcadia Systems</platform>
    <!-- The image (rtl/arcadia_loader.v): a 16-byte header (the ROM board's low-byte permutation, MAME's generic_decode
         order bit 7..0; flags, bit 0 Aaargh's map), Kickstart 1.3 (512 KB), the BIOS (512 KB, OnePlay 3.00 as MAME's
         default), the ROM board (1.5 MB). The ROMs stay as dumped: the core unscrambles them.
         Expects the MAME 0.289 merged romset or the split sets. Written by tools/make_mra.py. -->
    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,R"/>
    <rom index="0" zip="ar_spot.zip|ar_bios.zip" md5="3b891694769f89569ced619711dbda36">
        <!-- header -->
        <part>07 06 05 04 03 02 01 00 00 00 00 00 00 00 00 00</part>
        <!-- kickstart: Kickstart 1.3, twice -->
        <part name="315093-01.u2" crc="a6ce1636"/>
        <part name="315093-01.u2" crc="a6ce1636"/>
        <!-- user2: the BIOS, OnePlay 3.00 -->
        <interleave output="16">
            <part name="scpa_01-hi_v3.0.u12" crc="2d8e1a06" map="01"/>
            <part name="scpa_01-lo_v3.0.u16" crc="e4f38fab" map="10"/>
        </interleave>
        <part repeat="0x60000">00</part>
        <!-- user3: the ROM board -->
        <interleave output="16">
            <part name="spotv2.1h" crc="a8440838" map="01"/>
            <part name="spotv2.1l" crc="2abd2835" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="spotv2.2h" crc="f4c95f77" map="01"/>
            <part name="spotv2.2l" crc="58d7bf54" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="spotv2.3h" crc="c9d2f3b7" map="01"/>
            <part name="spotv2.3l" crc="adf94e81" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="spotv2.4h" crc="cdea2feb" map="01"/>
            <part name="spotv2.4l" crc="214c353b" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="spotv2.5h" crc="809d0f5c" map="01"/>
            <part name="spotv2.5l" crc="b86d8153" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="spotv2.6h" crc="8c221a34" map="01"/>
            <part name="spotv2.6l" crc="821fa69a" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="spotv2.7h" crc="054355db" map="01"/>
            <part name="spotv2.7l" crc="30d396d8" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="spotv2.8h" crc="94dbb239" map="01"/>
            <part name="spotv2.8l" crc="4d7f8f05" map="10"/>
        </interleave>
        <part repeat="0x80000">FF</part>
    </rom>
    <nvram index="4" size="16384"/>
</misterromdescription>
