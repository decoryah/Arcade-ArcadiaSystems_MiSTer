<misterromdescription>
    <name>Space Ranger (Arcadia, V 2.0)</name>
    <setname>ar_sprg</setname>
    <mameversion>0289</mameversion>
    <year>1987</year>
    <manufacturer>Arcadia Systems</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rotation>horizontal</rotation>
    <rbf>arcadiasystems</rbf>
    <platform>Arcadia Systems</platform>
    <!-- The image (rtl/arcadia_loader.v): a 16-byte header (the ROM board's low-byte permutation, MAME's generic_decode
         order bit 7..0; flags, bit 0 Aaargh's map), Kickstart 1.3 (512 KB), the BIOS (512 KB, OnePlay 3.00 as MAME's
         default), the ROM board (1.5 MB). The ROMs stay as dumped: the core unscrambles them.
         Expects the MAME 0.289 merged romset or the split sets. address=: fast loading, the image through the DDR3 (a
         Main_MiSTer without it streams the image). Written by tools/make_mra.py. -->
    <buttons names="Fire,Net,Start,Coin" default="A,B,Start,Select"/>
    <rom index="0" zip="ar_sprg.zip|ar_bios.zip" md5="7f5096c2f9b8b0648aca184a6e2a760a" address="0x32000000">
        <!-- header -->
        <part>04 07 03 00 06 05 02 01 00 00 00 00 00 00 00 00</part>
        <!-- kickstart: Kickstart 1.3, twice -->
        <part name="315093-01.u2" crc="a6ce1636"/>
        <part name="315093-01.u2" crc="a6ce1636"/>
        <!-- user2: the BIOS, OnePlay 3.00 -->
        <interleave output="16">
            <part name="scpa_01-hi_v3.0.u12" crc="2d8e1a06" map="01"/>
            <part name="scpa_01-lo_v3.0.u16" crc="e4f38fab" map="10"/>
        </interleave>
        <part repeat="0x60000">00</part>
        <!-- user3: the ROM board -->
        <interleave output="16">
            <part name="sprg_1h.bin" crc="90b45dc5" map="01"/>
            <part name="sprg_1l.bin" crc="e5ce68e9" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sprg_2h.bin" crc="02ef780f" map="01"/>
            <part name="sprg_2l.bin" crc="fa1f5b23" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sprg_3h.bin" crc="48130e6e" map="01"/>
            <part name="sprg_3l.bin" crc="4b968cc6" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="sprg_4h.bin" crc="23c8f667" map="01"/>
            <part name="sprg_4l.bin" crc="13ba011f" map="10"/>
        </interleave>
        <part repeat="0x100000">FF</part>
    </rom>
    <nvram index="4" size="16384"/>
</misterromdescription>
