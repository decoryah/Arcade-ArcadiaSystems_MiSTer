<misterromdescription>
    <name>World Darts (Arcadia, set 1, V 2.1)</name>
    <setname>ar_dart</setname>
    <mameversion>0289</mameversion>
    <year>1987</year>
    <manufacturer>Arcadia Systems</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rotation>horizontal</rotation>
    <rbf>arcadiasystems</rbf>
    <platform>Arcadia Systems</platform>
    <!-- The image (rtl/arcadia_loader.v): a 16-byte header (the ROM board's low-byte permutation, MAME's generic_decode
         order bit 7..0; flags, bit 0 Aaargh's map), Kickstart 1.3 (512 KB), the BIOS (512 KB, OnePlay 3.00 as MAME's
         default), the ROM board (1.5 MB). The ROMs stay as dumped: the core unscrambles them.
         Expects the MAME 0.289 merged romset or the split sets. Written by tools/make_mra.py. -->
    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,R"/>
    <rom index="0" zip="ar_dart.zip|ar_bios.zip" md5="9036e3718e5e24c2c408ef22572d4407">
        <!-- header -->
        <part>04 00 07 06 03 01 02 05 00 00 00 00 00 00 00 00</part>
        <!-- kickstart: Kickstart 1.3, twice -->
        <part name="315093-01.u2" crc="a6ce1636"/>
        <part name="315093-01.u2" crc="a6ce1636"/>
        <!-- user2: the BIOS, OnePlay 3.00 -->
        <interleave output="16">
            <part name="scpa_01-hi_v3.0.u12" crc="2d8e1a06" map="01"/>
            <part name="scpa_01-lo_v3.0.u16" crc="e4f38fab" map="10"/>
        </interleave>
        <part repeat="0x60000">00</part>
        <!-- user3: the ROM board -->
        <interleave output="16">
            <part name="dart_1h.bin" crc="4d6a33e2" map="01"/>
            <part name="dart_1l.bin" crc="3fa66973" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dart_2h.bin" crc="3a30426a" map="01"/>
            <part name="dart_2l.bin" crc="479c0b73" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dart_3h.bin" crc="dd217562" map="01"/>
            <part name="dart_3l.bin" crc="12cff829" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dart_4h.bin" crc="98b27f13" map="01"/>
            <part name="dart_4l.bin" crc="a059204c" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dart_5h.bin" crc="38f4c236" map="01"/>
            <part name="dart_5l.bin" crc="df4103cc" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dart_6h.bin" crc="e21cc8be" map="01"/>
            <part name="dart_6l.bin" crc="21112d4e" map="10"/>
        </interleave>
        <part repeat="0xC0000">FF</part>
    </rom>
    <nvram index="4" size="16384"/>
</misterromdescription>
