<misterromdescription>
    <name>Delta Command (Arcadia)</name>
    <setname>ar_dlta</setname>
    <mameversion>0289</mameversion>
    <year>1988</year>
    <manufacturer>Arcadia Systems</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rotation>horizontal</rotation>
    <rbf>arcadiasystems</rbf>
    <platform>Arcadia Systems</platform>
    <!-- The image (rtl/arcadia_loader.v): a 16-byte header (the ROM board's low-byte permutation, MAME's generic_decode
         order bit 7..0; flags, bit 0 Aaargh's map), Kickstart 1.3 (512 KB), the BIOS (512 KB, OnePlay 3.00 as MAME's
         default), the ROM board (1.5 MB). The ROMs stay as dumped: the core unscrambles them.
         Expects the MAME 0.289 merged romset or the split sets. Written by tools/make_mra.py. -->
    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,R"/>
    <rom index="0" zip="ar_dlta.zip|ar_bios.zip" md5="72cda3ab7ac6879d5d90a0c6665d6671">
        <!-- header -->
        <part>04 01 07 06 02 00 03 05 00 00 00 00 00 00 00 00</part>
        <!-- kickstart: Kickstart 1.3, twice -->
        <part name="315093-01.u2" crc="a6ce1636"/>
        <part name="315093-01.u2" crc="a6ce1636"/>
        <!-- user2: the BIOS, OnePlay 3.00 -->
        <interleave output="16">
            <part name="scpa_01-hi_v3.0.u12" crc="2d8e1a06" map="01"/>
            <part name="scpa_01-lo_v3.0.u16" crc="e4f38fab" map="10"/>
        </interleave>
        <part repeat="0x60000">00</part>
        <!-- user3: the ROM board -->
        <interleave output="16">
            <part name="dlta_v3_1-hi.bin" crc="3d428b49" map="01"/>
            <part name="dlta_v3_1-lo.bin" crc="e5d6508b" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dlta_v3_2-hi.bin" crc="e8a23dfe" map="01"/>
            <part name="dlta_v3_2-lo.bin" crc="84d82a8f" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dlta_v3_3-hi.bin" crc="75563b80" map="01"/>
            <part name="dlta_v3_3-lo.bin" crc="30b911b2" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dlta_v3_4-hi.bin" crc="80cd42a5" map="01"/>
            <part name="dlta_v3_4-lo.bin" crc="2fe13d9e" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dlta_v3_5-hi.bin" crc="960c9a17" map="01"/>
            <part name="dlta_v3_5-lo.bin" crc="79cbc0dd" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dlta_v3_6-hi.bin" crc="9df96431" map="01"/>
            <part name="dlta_v3_6-lo.bin" crc="5b0d7f30" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dlta_v3_7-hi.bin" crc="8e966e69" map="01"/>
            <part name="dlta_v3_7-lo.bin" crc="42553743" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="dlta_v3_8-hi.bin" crc="9ef08c31" map="01"/>
            <part name="dlta_v3_8-lo.bin" crc="7088bb88" map="10"/>
        </interleave>
        <part repeat="0x80000">FF</part>
    </rom>
    <nvram index="4" size="16384"/>
</misterromdescription>
