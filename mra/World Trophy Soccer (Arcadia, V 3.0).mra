<misterromdescription>
    <name>World Trophy Soccer (Arcadia, V 3.0)</name>
    <setname>ar_socc</setname>
    <mameversion>0289</mameversion>
    <year>1989</year>
    <manufacturer>Arcadia Systems</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rotation>horizontal</rotation>
    <rbf>arcadiasystems</rbf>
    <platform>Arcadia Systems</platform>
    <!-- The image (rtl/arcadia_loader.v): a 16-byte header (the ROM board's low-byte permutation, MAME's generic_decode
         order bit 7..0; flags, bit 0 Aaargh's map), Kickstart 1.3 (512 KB), the BIOS (512 KB, OnePlay 3.00 as MAME's
         default), the ROM board (1.5 MB). The ROMs stay as dumped: the core unscrambles them.
         Expects the MAME 0.289 merged romset or the split sets. Written by tools/make_mra.py. -->
    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,R"/>
    <rom index="0" zip="ar_socc.zip|ar_bios.zip" md5="d759f9c9f075084ee77ee20466af2303">
        <!-- header -->
        <part>00 07 01 06 05 04 03 02 00 00 00 00 00 00 00 00</part>
        <!-- kickstart: Kickstart 1.3, twice -->
        <part name="315093-01.u2" crc="a6ce1636"/>
        <part name="315093-01.u2" crc="a6ce1636"/>
        <!-- user2: the BIOS, OnePlay 3.00 -->
        <interleave output="16">
            <part name="scpa_01-hi_v3.0.u12" crc="2d8e1a06" map="01"/>
            <part name="scpa_01-lo_v3.0.u16" crc="e4f38fab" map="10"/>
        </interleave>
        <part repeat="0x60000">00</part>
        <!-- user3: the ROM board -->
        <interleave output="16">
            <part name="socc30.1hi" crc="b4df41cf" map="01"/>
            <part name="socc30.1lo" crc="28b5e119" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="socc30.2hi" crc="b3c14026" map="01"/>
            <part name="socc30.2lo" crc="f7f9a734" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="socc30.3hi" crc="2a2bd2a0" map="01"/>
            <part name="socc30.3lo" crc="f335bb8b" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="socc30.4hi" crc="4f2f28dc" map="01"/>
            <part name="socc30.4lo" crc="b326d36c" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="socc30.5hi" crc="4fcaec4a" map="01"/>
            <part name="socc30.5lo" crc="f131115e" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="socc30.6hi" crc="9380644f" map="01"/>
            <part name="socc30.6lo" crc="b93e13ea" map="10"/>
        </interleave>
        <part repeat="0xC0000">FF</part>
    </rom>
    <nvram index="4" size="16384"/>
</misterromdescription>
